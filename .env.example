# Milaan — detective configuration. Copy to `.env` and fill in.
# `.env` is gitignored: a key in the repository is a key on the internet.
#
# Every variable here is optional. With none of them set, the ladder runs
# deterministically — which is §11's ablated configuration, a reported outcome
# rather than a failure.

# Which vendor the detective calls. `groq` (default) or `anthropic`.
# An unrecognised value is an error, not a silent fall back to the default.
DETECTIVE_PROVIDER=groq

# Groq. Key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile.
# Priced models are listed in detective/provider.py::RATES; an unlisted model
# runs but reports zero cost rather than a guess.
GROQ_MODEL=

# Anthropic. Only read when DETECTIVE_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=
